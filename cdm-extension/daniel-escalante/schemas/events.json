{
  "job_start": {
    "type": "object", "additionalProperties": false,
    "required": ["type", "stage", "source"],
    "properties": {
      "type": {"type": "string", "enum": "event_type"},
      "stage": {"type": "string", "enum": "stage"},
      "source": {"type": "string", "enum": "source"},
      "variant": {"type": "string", "enum": "variant"},
      "split": {"type": "string", "enum": "split"},
      "commit": {"type": "string", "format": "identifier"},
      "protocol": {"type": "string", "format": "identifier"}
    }
  },
  "progress": {
    "type": "object", "additionalProperties": false,
    "required": ["type", "completed", "total"],
    "properties": {
      "type": {"type": "string", "enum": "event_type"},
      "completed": {"type": "integer", "minimum": 0},
      "total": {"type": "integer", "minimum": 0},
      "resumed": {"type": "boolean"}
    }
  },
  "job_end": {
    "type": "object", "additionalProperties": false,
    "required": ["type", "status"],
    "properties": {
      "type": {"type": "string", "enum": "event_type"},
      "status": {"type": "string", "enum": "status"},
      "patients": {"type": "integer", "minimum": 0},
      "seconds": {"type": "number", "minimum": 0}
    }
  },
  "error": {
    "type": "object", "additionalProperties": false,
    "required": ["type", "code", "exception_class"],
    "properties": {
      "type": {"type": "string", "enum": "event_type"},
      "code": {"type": "string", "enum": "error_code"},
      "exception_class": {"type": "string", "enum": "exception_class"}
    }
  }
}
