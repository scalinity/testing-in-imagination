# <TII>/pipeline/watcher.env -- settings for watcher_cycle.sh. Plain shell assignments, no secrets.
# Every variable set here is exported to the watcher and, through sbatch, to the jobs it submits.

# The study's storage root (AUTHORIZATION.md section 3) and the repository checkout on HiPerGator.
TII_ROOT=/blue/cai6734/daniel.escalante/private/tii-cee-1
TII_CODE=/blue/cai6734/daniel.escalante/CHECKOUT_PATH

# The Python that runs the stages: the cluster's 3.12 runtime environment. Required.
TII_PYTHON=/blue/cai6734/daniel.escalante/RUNTIME_ENV/bin/python

# The Python that runs the watcher itself. The compute nodes' /usr/bin/python3 is 3.9, which is
# all the watcher needs; change this only if that interpreter is missing.
# TII_WATCHER_PYTHON=/usr/bin/python3

# scrontab jobs do not run in a login shell. If sbatch, squeue, sacct or scrontab are not found,
# put their directory first (find it with `command -v sbatch` in a normal session).
# PATH=/opt/slurm/bin:$PATH

# The model cache the jobs use, as in the project's private environment file.
# HF_HOME=/blue/cai6734/daniel.escalante/cache/hf
