# Secrets & credentials
.env
.env.*
*.pem
*.key
credentials*

# PhysioNet / MIMIC / PHI — never commit
data/
**/mimic*/
# Exception: the checked aggregate-only export of the credentialed run (no rows, no IDs).
!replication-of-original/daniel-escalante/results/mimic/
replication-of-original/daniel-escalante/results/mimic/*
!replication-of-original/daniel-escalante/results/mimic/metrics.json
!replication-of-original/daniel-escalante/results/mimic/REPORT.md
!replication-of-original/daniel-escalante/results/mimic/supplementary.json
**/*physionet*
**/*.csv
!**/lab_test_mapping.example.csv

# Python / tooling
__pycache__/
*.py[cod]
.venv/
.uv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Experiment dumps (keep results/ structure; ignore large artifacts)
results/**/*.pt
results/**/*.bin
results/**/*.safetensors
results/**/wandb/
wandb/
evaluation/

# lacdm metric output: generated locally, never commit
lacdm/artifacts/*
