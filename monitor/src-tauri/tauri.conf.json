{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TII Monitor",
  "version": "0.1.0",
  "identifier": "edu.ufl.tii-monitor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TII Monitor",
        "width": 1168,
        "height": 733,
        "minWidth": 1120,
        "minHeight": 700,
        "center": true,
        "decorations": false,
        "resizable": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "category": "DeveloperTool",
    "macOS": { "minimumSystemVersion": "13.0" }
  }
}
